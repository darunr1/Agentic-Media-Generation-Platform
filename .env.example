# Copy this file to .env and fill in values. Never commit a real .env file.
#
# Every variable here is validated at process startup by
# packages/shared/src/env.ts — an invalid/missing required value fails
# immediately with a clear message instead of a confusing runtime error.

# --- Core ---------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# Matches docker-compose.yml's postgres service. If you're using the
# no-Docker fallback (`pnpm --filter @contentforge/database dev:db`), use
# postgresql://contentforge:contentforge@127.0.0.1:55432/contentforge_dev instead.
DATABASE_URL=postgresql://contentforge:contentforge@localhost:5432/contentforge_dev?schema=public

# --- Auth -----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-with-32+-character-random-string
AUTH_TRUST_HOST=true

# --- Encryption (OAuth token / secret-at-rest encryption) ----------------
# 32-byte key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# --- Storage ----------------------------------------------------------------
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.local-storage
# GCS_BUCKET=
# GCS_PROJECT_ID=

# --- Task queue ---------------------------------------------------------------
QUEUE_PROVIDER=postgres
# CLOUD_TASKS_PROJECT_ID=
# CLOUD_TASKS_LOCATION=
# CLOUD_TASKS_QUEUE=
# CLOUD_TASKS_WORKER_URL=

# --- AI providers (mock is the default and requires no keys) ----------------
AI_TEXT_PROVIDER=mock
AI_IMAGE_PROVIDER=mock
AI_VIDEO_PROVIDER=mock
AI_TTS_PROVIDER=mock
AI_TRANSCRIPTION_PROVIDER=mock
# Required only when selecting a real provider; use a model available to your account.
# OPENAI_TEXT_MODEL=
# GEMINI_API_KEY=
# GEMINI_TEXT_MODEL=
# OPENAI_IMAGE_MODEL=
# D03 config-only: OpenAI TTS is NOT supported by the production pipeline yet.
# The generation.voice worker is mock-only; startup validation rejects
# AI_TTS_PROVIDER=openai until D04 wires the real provider. Keep mock for now.
# Future D04 OpenAI TTS settings:
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
# OPENAI_API_KEY is shared by OpenAI text/image/TTS and listed separately below.
# Optional fallback (openai or gemini); mock is never an implicit fallback.
# AI_FALLBACK_PROVIDER=
AI_TIMEOUT_MS=45000
# Optional operator-supplied cost estimates. Missing prices are labeled unknown.
# OPENAI_INPUT_CENTS_PER_MILLION=
# OPENAI_OUTPUT_CENTS_PER_MILLION=
# GEMINI_INPUT_CENTS_PER_MILLION=
# GEMINI_OUTPUT_CENTS_PER_MILLION=
# OPENAI_IMAGE_COST_CENTS=
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=

# --- Workspace spending guardrails -------------------------------------------
DEFAULT_WORKSPACE_MONTHLY_BUDGET_CENTS=2000
DEFAULT_WORKSPACE_BUDGET_WARNING_PCT=0.8
MAX_GENERATION_JOBS_PER_CONTENT_ITEM=10

# --- Email (console logs locally by default — no SMTP needed) ---------------
EMAIL_PROVIDER=console
# RESEND_API_KEY=
EMAIL_FROM="ContentForge <notifications@contentforge.local>"

# --- Social (mock adapter by default) ----------------------------------------
SOCIAL_MOCK=true
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=

# --- Billing (Stripe test mode; billing UI shows "Setup required" without keys) --
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_GROWTH=
# STRIPE_PRICE_AGENCY=

# --- Rendering ----------------------------------------------------------------
RENDER_TIMEOUT_MS=120000
# FFMPEG_PATH=

# --- Observability -------------------------------------------------------------
LOG_LEVEL=info
