{
  "name": "@contentforge/web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev",
    "build": "dotenv -e ../../.env -v NODE_ENV=production -- next build",
    "start": "dotenv -e ../../.env -v NODE_ENV=production -- next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "clean": "rimraf .next"
  },
  "dependencies": {
    "@contentforge/ai": "workspace:*",
    "@contentforge/auth": "workspace:*",
    "@contentforge/billing": "workspace:*",
    "@contentforge/database": "workspace:*",
    "@contentforge/media": "workspace:*",
    "@contentforge/shared": "workspace:*",
    "@contentforge/social": "workspace:*",
    "@contentforge/ui": "workspace:*",
    "@contentforge/workflows": "workspace:*",
    "@hookform/resolvers": "5.5.7",
    "@tanstack/react-query": "5.101.4",
    "lucide-react": "1.28.0",
    "next": "15.5.22",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.83.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@contentforge/config": "workspace:*",
    "@eslint/eslintrc": "3.3.6",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.5.4",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.22",
    "eslint-config-prettier": "9.1.2",
    "jsdom": "25.0.1",
    "postcss": "8.5.25",
    "rimraf": "6.1.3",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
