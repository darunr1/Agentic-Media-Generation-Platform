{
  "name": "@contentforge/worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@contentforge/database": "workspace:*",
    "@contentforge/shared": "workspace:*",
    "@contentforge/workflows": "workspace:*"
  },
  "devDependencies": {
    "@contentforge/config": "workspace:*",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "rimraf": "6.1.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
