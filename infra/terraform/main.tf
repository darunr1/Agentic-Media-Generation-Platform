locals { prefix = "contentforge-${var.environment}" required_apis = toset(["run.googleapis.com","sqladmin.googleapis.com","storage.googleapis.com","cloudtasks.googleapis.com","cloudscheduler.googleapis.com","secretmanager.googleapis.com","artifactregistry.googleapis.com","logging.googleapis.com","monitoring.googleapis.com"]) }
resource "google_project_service" "services" { for_each = local.required_apis service = each.value disable_on_destroy = false }
resource "random_id" "suffix" { byte_length = 4 }
resource "google_artifact_registry_repository" "app" { location = var.region repository_id = local.prefix format = "DOCKER" depends_on = [google_project_service.services] }
resource "google_storage_bucket" "media" { name = "${local.prefix}-media-${random_id.suffix.hex}" location = var.region uniform_bucket_level_access = true public_access_prevention = "enforced" versioning { enabled = true } lifecycle_rule { condition { age = 30 matches_prefix = ["tmp/"] } action { type = "Delete" } } }
resource "google_sql_database_instance" "postgres" { name = "${local.prefix}-postgres" region = var.region database_version = "POSTGRES_16" deletion_protection = true settings { tier = "db-custom-1-3840" availability_type = "REGIONAL" backup_configuration { enabled = true point_in_time_recovery_enabled = true } ip_configuration { ipv4_enabled = false private_network = "projects/${var.project_id}/global/networks/default" } } depends_on = [google_project_service.services] }
resource "google_sql_database" "app" { name = "contentforge" instance = google_sql_database_instance.postgres.name }
resource "google_service_account" "runtime" { account_id = "${local.prefix}-runtime" display_name = "ContentForge runtime" }
resource "google_secret_manager_secret" "runtime" { for_each = toset(["database-url","auth-secret","encryption-key","stripe-secret-key","stripe-webhook-secret"]) secret_id = "${local.prefix}-${each.value}" replication { auto {} } }
resource "google_cloud_tasks_queue" "default" { name = "${local.prefix}-tasks" location = var.region rate_limits { max_concurrent_dispatches = 20 max_dispatches_per_second = 10 } retry_config { max_attempts = 5 max_retry_duration = "3600s" min_backoff = "1s" max_backoff = "300s" max_doublings = 5 } }
resource "google_cloud_run_v2_service" "web" { name = "${local.prefix}-web" location = var.region deletion_protection = true template { service_account = google_service_account.runtime.email scaling { min_instance_count = 1 max_instance_count = 20 } containers { image = var.web_image ports { container_port = 3000 } env { name = "NODE_ENV" value = "production" } } } depends_on = [google_project_service.services] }
resource "google_cloud_run_v2_service" "worker" { name = "${local.prefix}-worker" location = var.region deletion_protection = true template { service_account = google_service_account.runtime.email scaling { min_instance_count = 1 max_instance_count = 20 } containers { image = var.worker_image ports { container_port = 3001 } } } depends_on = [google_project_service.services] }
resource "google_cloud_run_v2_job" "renderer" { name = "${local.prefix}-renderer" location = var.region deletion_protection = true template { template { service_account = google_service_account.runtime.email timeout = "1800s" max_retries = 1 containers { image = var.renderer_image resources { limits = { cpu = "2" memory = "4Gi" } } } } } depends_on = [google_project_service.services] }
resource "google_cloud_scheduler_job" "publishing" { name = "${local.prefix}-publishing" region = var.region schedule = "*/5 * * * *" time_zone = "Etc/UTC" http_target { uri = "${google_cloud_run_v2_service.worker.uri}/internal/scheduled/publish" http_method = "POST" oidc_token { service_account_email = google_service_account.runtime.email } } }
resource "google_cloud_scheduler_job" "analytics" { name = "${local.prefix}-analytics" region = var.region schedule = "0 */6 * * *" time_zone = "Etc/UTC" http_target { uri = "${google_cloud_run_v2_service.worker.uri}/internal/scheduled/analytics" http_method = "POST" oidc_token { service_account_email = google_service_account.runtime.email } } }
