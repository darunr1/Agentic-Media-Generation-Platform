{
  "name": "contentforge",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e --filter=@contentforge/web",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "clean": "turbo run clean && rimraf node_modules",
    "db:generate": "dotenv -e .env -- pnpm --filter @contentforge/database db:generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @contentforge/database db:migrate",
    "db:seed": "dotenv -e .env -- pnpm --filter @contentforge/database db:seed",
    "db:studio": "dotenv -e .env -- pnpm --filter @contentforge/database db:studio"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "dotenv-cli": "11.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.6.14",
    "rimraf": "6.1.3",
    "turbo": "2.10.8",
    "typescript": "5.9.3"
  }
}
